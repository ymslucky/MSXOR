---
import '../styles/global.css';
import '../styles/inter.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  path: string;
}

const { title, description, lang, path } = Astro.props;
---

<!doctype html>
<html lang={lang} class="bg-ink">
  <head>
    <BaseHead title={title} description={description} lang={lang} path={path} />
    <slot name="head" />
  </head>
  <body class="bg-ink font-sans text-slate-200 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:text-ink"
    >
      Skip to content
    </a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      import '../utils/animations';
    </script>
  </body>
</html>
