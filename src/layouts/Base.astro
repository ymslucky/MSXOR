---
import '../styles/global.css';
import '../styles/inter.css';
import '../styles/jetbrains.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  path: string;
}

const { title, description, lang, path } = Astro.props;
---

<!doctype html>
<html lang={lang} class="bg-canvas">
  <head>
    <BaseHead title={title} description={description} lang={lang} path={path} />
  </head>
  <body class="bg-canvas font-sans text-ink antialiased">
    <div id="scroll-progress" aria-hidden="true"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded focus:bg-surface focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:text-ink focus:shadow"
    >
      Skip to content
    </a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <CommandPalette lang={lang} path={path} />

    <script>
      import '../utils/animations';
    </script>
  </body>
</html>
