---
import SectionShell from './SectionShell.astro';
import { t, type Lang } from '../i18n/ui';
import { articles } from '../data/articles';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<SectionShell
  id="articles"
  number="03"
  label={T.articles.label}
  title={T.articles.title}
  subtitle={T.articles.subtitle}
  lang={lang}
  split="3/9"
  tone="gray"
>
  <div class="flex flex-col gap-4">
    {
      articles.map((article, index) => (
        <article
          class:list={['card card-pad flex flex-col gap-3', index === 0 && 'card-featured']}
          data-animate
          data-animate-delay={index * 0.05}
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="badge badge-accent">{T.articles.drafting}</span>
            <span class="font-mono text-[11px] text-text-muted">
              {article.minutes} {T.articles.minutes}
            </span>
          </div>
          <h3
            class:list={[
              'font-semibold text-text-primary',
              index === 0 ? 't-h3' : 't-body font-semibold',
            ]}
          >
            {article.title[lang]}
          </h3>
          <p class="t-small r-75 text-text-secondary">{article.summary[lang]}</p>
          <ul class="flex flex-wrap gap-1.5">
            {article.tags.map((tag) => (
              <li class="badge">{tag}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <p class="mt-5 font-mono text-[11px] text-text-muted" data-animate>{T.articles.tbdHint}</p>
</SectionShell>
