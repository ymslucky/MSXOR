---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/ui';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  lang: Lang;
  delay?: number;
}

const { project, lang, delay = 0 } = Astro.props;
const T = t(lang);
---

<div class="card flex flex-col p-6" data-animate data-animate-delay={delay} data-tilt>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-mono text-sm font-semibold text-ink">{project.name}</h3>
    <div class="flex items-center gap-2">
      {project.version && <span class="badge">{project.version}</span>}
      <span class="badge badge-ok">{project.status[lang]}</span>
    </div>
  </div>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-2">{project.tagline[lang]}</p>

  {
    project.stack.length > 0 && (
      <div class="mt-4">
        <p class="font-mono text-[11px] text-ink-3">{T.projects.stackTitle}</p>
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {project.stack.map((tech) => (
            <li class="badge">{tech}</li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="mt-5 flex items-center gap-4 border-t border-line pt-4 font-mono text-xs">
    <a
      href={project.href}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-accent hover:underline"
    >
      {project.repo ? T.projects.repo : T.projects.site}
      <Icon name="arrow" class="h-3.5 w-3.5" />
    </a>
    {project.repo && <span class="text-ink-3 select-none">·</span>}
    {project.repo && <span class="text-ink-3">{project.repo}</span>}
  </div>
</div>
