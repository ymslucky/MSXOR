---
import Icon from './Icon.astro';
import CodeBlock from './CodeBlock.astro';
import { t, type Lang } from '../i18n/ui';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  lang: Lang;
  delay?: number;
}

const { project, lang, delay = 0 } = Astro.props;
const T = t(lang);
const cmd =
  project.id === 'drive'
    ? 'msxor drive sync ./data --encrypt'
    : project.id === 'iam'
      ? 'msxor iam auth --sso --mfa'
      : 'git clone https://github.com/ymslucky/MSXOR.git';
---

<div
  class:list={['card card-pad flex flex-col', project.featured && 'card-featured']}
  data-animate
  data-animate-delay={delay}
  data-tilt
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <h3 class="t-h3 font-mono font-semibold text-text-primary">{project.name}</h3>
    <div class="flex items-center gap-2">
      {project.version && <span class="badge">{project.version}</span>}
      <span class="badge badge-ok">{project.status[lang]}</span>
    </div>
  </div>

  <p class="t-body r-65 mt-3 flex-1 text-text-secondary">{project.tagline[lang]}</p>

  {
    project.stack.length > 0 && (
      <div class="mt-4">
        <p class="font-mono text-[11px] text-text-muted">{T.projects.stackTitle}</p>
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {project.stack.map((tech) => (
            <li class="badge">{tech}</li>
          ))}
        </ul>
      </div>
    )
  }

  <CodeBlock class="mt-4" lang="sh">{cmd}</CodeBlock>

  <div
    class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-border pt-4 font-mono text-xs"
  >
    <a
      href={project.href}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-accent hover:underline"
    >
      {project.repo ? T.projects.repo : T.projects.site}
      <Icon name="arrow" class="h-3.5 w-3.5" />
    </a>
    {project.repo && <span class="text-text-muted select-none">·</span>}
    {project.repo && <span class="text-text-muted">{project.repo}</span>}
  </div>
</div>
