---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/ui';
import type { Product } from '../data/products';

interface Props {
  product: Product;
  lang: Lang;
  delay?: number;
}

const { product, lang, delay = 0 } = Astro.props;
const T = t(lang);

const accentClasses = {
  cyan: 'border-cyan-200 bg-cyan-50 text-cyan-700',
  violet: 'border-blue-200 bg-blue-50 text-blue-700',
} as const;
---

<a
  href={product.href}
  target="_blank"
  rel="noopener noreferrer"
  class="card group block p-6"
  data-animate
  data-animate-delay={delay}
  data-tilt
>
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-3">
      <span
        class:list={[
          'inline-flex h-10 w-10 items-center justify-center rounded-md border',
          accentClasses[product.accent],
        ]}
      >
        <Icon name={product.icon} class="h-5 w-5" />
      </span>
      <div>
        <h3 class="font-mono text-sm font-semibold text-ink">{product.name}</h3>
        {product.status && <span class="badge mt-1">{product.status[lang]}</span>}
      </div>
    </div>
  </div>

  <p class="mt-4 text-sm leading-relaxed text-ink-2">{product.tagline[lang]}</p>

  <pre
    class="code-block mt-4"><span class="c-prompt">$ </span>msxor {product.id} <span class="c-flag">{product.id === 'drive' ? 'sync ./data --encrypt' : 'auth --sso --mfa'}</span></pre>

  <span class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs text-accent">
    {T.products.learnMore}
    <span aria-hidden="true">→</span>
  </span>
</a>
