---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/ui';
import type { Product } from '../data/products';

interface Props {
  product: Product;
  lang: Lang;
  delay?: number;
}

const { product, lang, delay = 0 } = Astro.props;
const T = t(lang);

const accentClasses = {
  cyan: 'from-cyan-400/25 to-sky-500/10 text-cyan-300 shadow-cyan-500/20',
  violet: 'from-violet-400/25 to-fuchsia-500/10 text-violet-300 shadow-violet-500/20',
} as const;
---

<a
  href={product.href}
  target="_blank"
  rel="noopener noreferrer"
  class="glass group relative block overflow-hidden p-8"
  data-animate
  data-animate-delay={delay}
  data-tilt
  data-animate-pop
>
  <div
    class="pointer-events-none absolute -top-24 -right-24 h-56 w-56 rounded-full opacity-0 blur-[80px] transition-opacity duration-500 group-hover:opacity-100"
    class:list={[product.accent === 'cyan' ? 'bg-cyan-400/25' : 'bg-violet-400/25']}
    aria-hidden="true"
  >
  </div>

  <div class="flex items-start justify-between">
    <span
      class:list={[
        'inline-flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br shadow-lg',
        accentClasses[product.accent],
      ]}
    >
      <Icon name={product.icon} class="h-6 w-6" />
    </span>

    {
      product.status && (
        <span class="rounded-full border border-white/10 px-3 py-1 text-xs text-slate-400">
          {product.status[lang]}
        </span>
      )
    }
  </div>

  <h3 class="mt-6 text-xl font-semibold text-white">{product.name}</h3>
  <p class="mt-3 text-sm leading-relaxed text-slate-400">{product.tagline[lang]}</p>

  <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-cyan-300">
    {T.products.learnMore}
    <Icon
      name="arrow"
      class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
    />
  </span>
</a>
