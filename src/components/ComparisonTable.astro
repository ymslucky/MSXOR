---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { tx, compareRows, plans } from '../data/plans';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<section data-bg="#07050f" class="relative py-28 md:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading
      lang={lang}
      label={T.pricing.compare}
      title={T.pricing.compare}
      subtitle={T.pricing.compareSubtitle}
    />

    <div class="mt-14 overflow-x-auto" data-animate>
      <table class="w-full min-w-[560px] border-separate border-spacing-0 text-left text-sm">
        <thead>
          <tr>
            <th class="pb-5" scope="col"><span class="sr-only">Feature</span></th>
            {
              plans.map((plan) => (
                <th scope="col" class="pb-5 text-center">
                  <span
                    class:list={['font-semibold', plan.popular ? 'text-gradient' : 'text-white']}
                  >
                    {plan.name}
                  </span>
                  {plan.popular && (
                    <span class="mt-1 block text-xs text-slate-400">{T.plan.popular}</span>
                  )}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            compareRows.map((row, rowIndex) => (
              <tr>
                <th
                  scope="row"
                  class:list={[
                    'py-4 pr-4 font-normal text-slate-300',
                    rowIndex > 0 && 'border-t border-white/8',
                  ]}
                >
                  {row.label[lang]}
                </th>
                {plans.map((plan) => {
                  const value = tx(row.values[plan.id], lang);
                  const isCheck = value === '✓';
                  const isDash = value === '—';
                  return (
                    <td
                      class:list={[
                        'py-4 text-center',
                        rowIndex > 0 && 'border-t border-white/8',
                        plan.popular && 'bg-white/[0.03]',
                        isCheck && 'text-cyan-300',
                        isDash && 'text-slate-600',
                      ]}
                    >
                      {isCheck ? (
                        <Icon name="check" class="mx-auto h-4 w-4" />
                      ) : (
                        <span class:list={[isDash && 'select-none']}>{value}</span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
