---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { tx, compareRows, plans } from '../data/plans';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<section class="relative bg-canvas py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <hr class="divider-dashed" data-animate />
    <div class="mt-14">
      <SectionHeading
        lang={lang}
        label={T.pricing.compare.toLowerCase()}
        title={T.pricing.compare}
        subtitle={T.pricing.compareSubtitle}
      />
    </div>

    <div class="card mt-12 overflow-x-auto" data-animate>
      <table class="w-full min-w-[560px] border-collapse text-left font-mono text-xs">
        <thead>
          <tr class="border-b border-line bg-surface-2">
            <th class="px-4 py-3 font-medium text-ink-3" scope="col"
              ><span class="sr-only">Feature</span></th
            >
            {
              plans.map((plan) => (
                <th scope="col" class="px-4 py-3 text-center font-semibold text-ink">
                  {plan.name}
                  {plan.popular && <span class="ml-2 badge badge-accent">{T.plan.popular}</span>}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            compareRows.map((row) => (
              <tr class="border-b border-line last:border-0">
                <th scope="row" class="px-4 py-3 font-normal text-ink-2">
                  {row.label[lang]}
                </th>
                {plans.map((plan) => {
                  const value = tx(row.values[plan.id], lang);
                  const isCheck = value === '✓';
                  const isDash = value === '—';
                  return (
                    <td
                      class:list={[
                        'px-4 py-3 text-center',
                        isCheck && 'text-ok',
                        isDash && 'text-ink-3',
                      ]}
                    >
                      {isCheck ? <Icon name="check" class="mx-auto h-4 w-4" /> : value}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
