---
import SectionHeading from './SectionHeading.astro';
import PlanCard from './plans/PlanCard.astro';
import { t, pricingPath, type Lang } from '../i18n/ui';
import { plans } from '../data/plans';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<section class="relative bg-canvas-2 py-20 md:py-28">
  <div class="grid-bg-soft absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-6">
    <hr class="divider-dashed" data-animate />
    <div class="mt-14">
      <SectionHeading
        lang={lang}
        label={T.pricingPreview.label}
        title={T.pricingPreview.title}
        subtitle={T.pricingPreview.subtitle}
      />
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        plans.map((plan, index) => (
          <PlanCard plan={plan} lang={lang} mode="preview" delay={index * 0.08} />
        ))
      }
    </div>

    <div class="mt-10 text-center" data-animate>
      <a href={pricingPath(lang)} class="btn" data-magnetic>{T.pricingPreview.cta} →</a>
    </div>
  </div>
</section>
