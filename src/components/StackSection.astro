---
import SectionShell from './SectionShell.astro';
import { t, type Lang } from '../i18n/ui';
import { stackRows } from '../data/stack';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<SectionShell
  id="stack"
  number="04"
  label={T.stack.label}
  title={T.stack.title}
  subtitle={T.stack.subtitle}
  lang={lang}
  split="5/7"
  tone="white"
>
  <div class="card overflow-x-auto" data-animate>
    <table class="responsive-table w-full min-w-[560px] border-collapse text-left font-mono t-code">
      <thead>
        <tr class="border-b border-border bg-surface-2">
          <th scope="col" class="px-4 py-3 font-medium text-text-muted">{T.stack.category}</th>
          <th scope="col" class="px-4 py-3 font-medium text-text-muted">{T.stack.tool}</th>
          <th scope="col" class="px-4 py-3 font-medium text-text-muted">{T.stack.use}</th>
          <th scope="col" class="px-4 py-3 font-medium text-text-muted">{T.stack.alt}</th>
        </tr>
      </thead>
      <tbody>
        {
          stackRows.map((row, index) => (
            <tr
              class:list={[
                'border-b border-border last:border-0',
                index === 0 && 'row-featured',
                row.tbd && 'opacity-70',
              ]}
            >
              <th scope="row" class="px-4 py-3 font-normal whitespace-nowrap text-text-secondary">
                {row.category[lang]}
              </th>
              <td
                class="px-4 py-3 font-semibold whitespace-nowrap text-text-primary"
                data-label={T.stack.tool}
              >
                {row.tool}
                {row.tbd && <span class="badge badge-accent ml-2">{T.stack.tbd}</span>}
              </td>
              <td class="px-4 py-3 text-text-secondary" data-label={T.stack.use}>
                {row.use[lang]}
              </td>
              <td class="px-4 py-3 text-text-muted" data-label={T.stack.alt}>
                {row.alt}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</SectionShell>
