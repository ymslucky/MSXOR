---
import { languages, alternatePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
---

<div
  class="flex items-center gap-0.5 rounded border border-line bg-surface p-0.5 font-mono text-[11px]"
>
  {
    Object.entries(languages).map(([code, label]) => {
      const target = code as Lang;
      const active = target === lang;
      return (
        <a
          href={alternatePath(path, target)}
          hreflang={code}
          data-lang-link={code}
          aria-current={active ? 'true' : undefined}
          class:list={[
            'rounded px-2 py-1 transition-colors',
            active ? 'bg-surface-2 text-ink' : 'text-ink-3 hover:text-ink',
          ]}
        >
          {label}
        </a>
      );
    })
  }
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        sessionStorage.setItem('msxor-lang', link.dataset.langLink ?? '');
      } catch {
        /* storage unavailable — ignore */
      }
    });
  });
</script>
