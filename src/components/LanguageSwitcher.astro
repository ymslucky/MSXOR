---
import { languages, alternatePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
---

<div class="flex items-center gap-1 rounded-full border border-white/10 p-1 text-xs">
  {
    Object.entries(languages).map(([code, label]) => {
      const target = code as Lang;
      const active = target === lang;
      return (
        <a
          href={alternatePath(path, target)}
          hreflang={code}
          data-lang-link={code}
          aria-current={active ? 'true' : undefined}
          class:list={[
            'rounded-full px-3 py-1.5 transition-colors',
            active ? 'bg-white/10 text-white' : 'text-slate-400 hover:text-white',
          ]}
        >
          {label}
        </a>
      );
    })
  }
</div>

<script>
  // Remember explicit language choice so auto-redirect never fights the user.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        sessionStorage.setItem('msxor-lang', link.dataset.langLink ?? '');
      } catch {
        /* storage unavailable — ignore */
      }
    });
  });
</script>
