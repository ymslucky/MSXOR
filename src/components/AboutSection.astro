---
import SectionShell from './SectionShell.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<SectionShell
  id="about"
  number="06"
  label={T.about.label}
  title={T.about.title}
  subtitle={T.about.subtitle}
  lang={lang}
  split="5/7"
  tone="gray"
>
  <div class="flex flex-col gap-6">
    <div class="card card-featured card-pad">
      <h3 class="t-h3 font-mono font-semibold text-text-primary">{T.about.xorTitle}</h3>
      <p class="t-body r-65 mt-2 text-text-secondary">{T.about.xorSubtitle}</p>
    </div>
    <div class="grid-cards">
      {
        T.about.cards.map((card, index) => (
          <div class="card card-pad" data-animate data-animate-delay={index * 0.05}>
            <p class="font-mono text-lg font-semibold text-accent">{card.expr}</p>
            <h4 class="mt-2 text-xs font-semibold text-text-primary">{card.title}</h4>
            <p class="t-small r-55 mt-1 text-text-secondary">{card.body}</p>
          </div>
        ))
      }
    </div>
    <div class="card card-pad" data-animate data-animate-delay="0.1">
      <h3 class="t-h3 font-mono font-semibold text-text-primary">{T.about.aiEraTitle}</h3>
      <p class="t-body r-65 mt-3 text-text-secondary">{T.about.aiEraBody}</p>
    </div>
  </div>
</SectionShell>
