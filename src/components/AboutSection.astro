---
import SectionHeading from './SectionHeading.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<section id="about" class="relative scroll-mt-24 bg-canvas-2 py-20 md:py-28">
  <div class="grid-bg-soft absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-6">
    <hr class="divider-dashed" data-animate />
    <div class="mt-14">
      <SectionHeading
        lang={lang}
        label={T.about.label}
        title={T.about.title}
        subtitle={T.about.subtitle}
      />
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <h3 class="font-mono text-sm font-semibold text-ink">{T.about.xorTitle}</h3>
        <p class="mt-2 text-sm text-ink-2">{T.about.xorSubtitle}</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {
            T.about.cards.map((card, index) => (
              <div class="card p-4" data-animate data-animate-delay={index * 0.05}>
                <p class="font-mono text-base font-semibold text-accent">{card.expr}</p>
                <h4 class="mt-2 text-xs font-semibold text-ink">{card.title}</h4>
                <p class="mt-1 text-xs leading-relaxed text-ink-2">{card.body}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="card p-6" data-animate data-animate-delay="0.1">
        <h3 class="font-mono text-sm font-semibold text-ink">{T.about.aiEraTitle}</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-2">{T.about.aiEraBody}</p>
      </div>
    </div>
  </div>
</section>
