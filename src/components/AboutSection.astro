---
import SectionShell from './SectionShell.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<SectionShell
  id="about"
  number="06"
  label={T.about.label}
  title={T.about.title}
  subtitle={T.about.subtitle}
  lang={lang}
  tone="bg-bg-2"
>
  <div class="grid gap-5 lg:grid-cols-[1.25fr_1fr]">
    <div>
      <h3 class="t-h3 font-mono font-semibold text-text-primary">{T.about.xorTitle}</h3>
      <p class="t-body mt-2 text-text-secondary">{T.about.xorSubtitle}</p>
      <div class="mt-5 grid-cards">
        {
          T.about.cards.map((card, index) => (
            <div class="card card-pad" data-animate data-animate-delay={index * 0.05}>
              <p class="font-mono text-lg font-semibold text-accent">{card.expr}</p>
              <h4 class="mt-2 text-xs font-semibold text-text-primary">{card.title}</h4>
              <p class="t-small mt-1 text-text-secondary">{card.body}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="card card-pad self-start" data-animate data-animate-delay="0.1">
      <h3 class="t-h3 font-mono font-semibold text-text-primary">{T.about.aiEraTitle}</h3>
      <p class="t-body mt-3 text-text-secondary">{T.about.aiEraBody}</p>
    </div>
  </div>
</SectionShell>
