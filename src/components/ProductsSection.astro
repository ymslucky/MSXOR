---
import SectionHeading from './SectionHeading.astro';
import ProductCard from './ProductCard.astro';
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/ui';
import { products } from '../data/products';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<section id="products" class="relative scroll-mt-24 bg-canvas-2 py-20 md:py-28">
  <div class="grid-bg-soft absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-6">
    <hr class="divider-dashed" data-animate />
    <div class="mt-14">
      <SectionHeading
        lang={lang}
        label={T.products.label}
        title={T.products.title}
        subtitle={T.products.subtitle}
      />
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        products.map((product, index) => (
          <ProductCard product={product} lang={lang} delay={index * 0.08} />
        ))
      }
    </div>

    <p
      class="mt-8 flex items-center justify-center gap-2 font-mono text-xs text-ink-3"
      data-animate
    >
      <Icon name="sparkles" class="h-4 w-4" />
      {T.products.more}
    </p>
  </div>
</section>
