---
import SectionHeading from './SectionHeading.astro';
import { faqItems } from '../data/plans';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<section data-bg="#04070d" class="relative py-28 md:py-32">
  <div class="mx-auto max-w-3xl px-6">
    <SectionHeading lang={lang} label="FAQ" title={T.pricing.faqTitle} />

    <div class="mt-12 space-y-4">
      {
        faqItems.map((item, index) => (
          <details
            class="glass group px-6 py-5 [&_summary::-webkit-details-marker]:hidden"
            data-animate
            data-animate-delay={index * 0.06}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-white">
              {item.q[lang]}
              <span class="text-slate-400 transition-transform duration-300 group-open:rotate-45">
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="mt-4 text-sm leading-relaxed text-slate-400">{item.a[lang]}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
