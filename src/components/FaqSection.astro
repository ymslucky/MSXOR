---
import SectionHeading from './SectionHeading.astro';
import { faqItems } from '../data/plans';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<section class="section relative bg-bg">
  <div class="shell">
    <hr class="divider-dashed" data-animate />
    <div class="mt-14">
      <SectionHeading lang={lang} label="faq" title={T.pricing.faqTitle} />
    </div>

    <div class="card mt-12 divide-y divide-line" data-animate>
      {
        faqItems.map((item, index) => (
          <details
            class="group px-5 py-4 [&_summary::-webkit-details-marker]:hidden"
            data-animate
            data-animate-delay={index * 0.05}
          >
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-mono text-sm text-text-primary">
              <span>
                <span class="text-accent">Q: </span>
                {item.q[lang]}
              </span>
              <span
                class="mt-0.5 text-text-muted transition-transform duration-150 group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mt-3 font-mono text-xs leading-relaxed text-text-secondary">
              <span class="text-ok">A: </span>
              {item.a[lang]}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
