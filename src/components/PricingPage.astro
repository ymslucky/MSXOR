---
import PlanCard from './plans/PlanCard.astro';
import ComparisonTable from './ComparisonTable.astro';
import FaqSection from './FaqSection.astro';
import CtaBanner from './CtaBanner.astro';
import { t, type Lang } from '../i18n/ui';
import { plans } from '../data/plans';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<section class="relative overflow-hidden bg-canvas pt-32 pb-10 md:pt-40">
  <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
  <div class="shell relative text-center" data-animate>
    <p class="font-mono text-xs text-accent">~/pricing</p>
    <h1 class="mt-3 font-mono text-4xl font-bold tracking-tight text-ink md:text-6xl">
      {T.pricing.title}
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-sm leading-relaxed text-pretty text-ink-2 md:text-base">
      {T.pricing.subtitle}
    </p>
    <p class="badge badge-ok mt-5">{T.plan.perMonth}</p>
  </div>
</section>

<section class="bg-canvas pb-6">
  <div class="shell">
    <div class="grid-cards-wide pt-8">
      {plans.map((plan, index) => <PlanCard plan={plan} lang={lang} delay={index * 0.08} />)}
    </div>
  </div>
</section>

<ComparisonTable lang={lang} />
<FaqSection lang={lang} />
<CtaBanner lang={lang} />
