---
import Icon from './Icon.astro';
import { t, githubUrl, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
const links = [
  { label: T.contact.github, href: githubUrl, ready: true },
  { label: T.contact.x, href: '#', ready: false },
  { label: T.contact.email, href: '#', ready: false },
  { label: T.contact.rss, href: '#', ready: false },
];
---

<section id="contact" class="relative scroll-mt-24 bg-canvas py-20 md:py-24">
  <div class="mx-auto max-w-2xl px-6">
    <hr class="divider-dashed" data-animate />
    <div class="card mt-12 p-8 text-center" data-animate>
      <p class="font-mono text-xs text-accent">{T.contact.label}</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink">{T.contact.title}</h2>
      <p class="mt-3 text-sm text-ink-2">{T.contact.subtitle}</p>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        {
          links.map((link) =>
            link.ready ? (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-accent"
                data-magnetic
              >
                <Icon name="github" class="h-4 w-4" />
                {link.label}
              </a>
            ) : (
              <span class="btn cursor-not-allowed opacity-60" aria-disabled="true" title="TBD">
                {link.label} · TBD
              </span>
            ),
          )
        }
      </div>
    </div>
  </div>
</section>
