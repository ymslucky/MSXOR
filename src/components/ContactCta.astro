---
import Icon from './Icon.astro';
import { t, githubUrl, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
const links = [
  { label: T.contact.github, href: githubUrl, ready: true },
  { label: T.contact.x, href: '#', ready: false },
  { label: T.contact.email, href: '#', ready: false },
  { label: T.contact.rss, href: '#', ready: false },
];
---

<section id="contact" class="section tone-bordered relative scroll-mt-24 tone-white">
  <div class="content-grid">
    <div class="mx-auto max-w-[720px]" data-animate>
      <p class="section-label">07 / contact</p>
      <div class="card card-featured card-pad mt-6 p-8 text-center md:p-10">
        <h2 class="t-h2 font-semibold tracking-tight text-text-primary">{T.contact.title}</h2>
        <p class="t-body r-65 mx-auto mt-3 text-text-secondary">{T.contact.subtitle}</p>

        <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
          {
            links.map((link) =>
              link.ready ? (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-accent"
                  data-magnetic
                >
                  <Icon name="github" class="h-4 w-4" />
                  {link.label}
                </a>
              ) : (
                <span class="btn cursor-not-allowed" aria-disabled="true" title="TBD">
                  {link.label} · TBD
                </span>
              ),
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
