---
import SectionHeading from './SectionHeading.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<section class="relative bg-canvas py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <hr class="divider-dashed" data-animate />
    <div class="mt-14">
      <SectionHeading
        lang={lang}
        label={T.xor.label}
        title={T.xor.title}
        subtitle={T.xor.subtitle}
      />
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        T.xor.cards.map((card, index) => (
          <div class="card p-5" data-animate data-animate-delay={index * 0.06}>
            <p class="font-mono text-lg font-semibold text-accent">{card.expr}</p>
            <h3 class="mt-3 text-sm font-semibold text-ink">{card.title}</h3>
            <p class="mt-1.5 text-xs leading-relaxed text-ink-2">{card.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
