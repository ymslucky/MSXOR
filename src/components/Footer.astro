---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, homePath, sectionPath, githubUrl, type Lang } from '../i18n/ui';
import { projects } from '../data/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
const year = new Date().getFullYear();
const commit = __COMMIT_HASH__;
const buildTime = __BUILD_TIME__;
const buildDate = buildTime.slice(0, 10);
const sectionLinks = [
  { label: T.nav.now, id: 'now' },
  { label: T.nav.projects, id: 'projects' },
  { label: T.nav.articles, id: 'articles' },
  { label: T.nav.stack, id: 'stack' },
  { label: T.nav.path, id: 'path' },
  { label: T.nav.about, id: 'about' },
];
---

<footer class="border-t border-line bg-surface">
  <div class="shell py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a
          href={homePath(lang)}
          class="flex items-baseline gap-0 font-mono text-sm"
          aria-label="MSXOR — home"
        >
          <span class="text-ink-3">~/</span><span class="font-semibold text-ink">msxor</span>
          <span class="ml-1.5 text-accent">$</span>
        </a>
        <p class="mt-3 max-w-xs text-xs leading-relaxed text-ink-2">{T.footer.tagline}</p>
        <div class="mt-4 flex items-center gap-2">
          <span class="status-dot"></span>
          <span class="badge badge-ok">{T.footer.operational}</span>
        </div>
      </div>

      <nav aria-label={T.footer.sections}>
        <h2 class="font-mono text-xs font-semibold text-ink">{T.footer.sections}</h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-3 gap-y-2 font-mono text-xs text-ink-2">
          {
            sectionLinks.map((link) => (
              <li>
                <a class="hover:text-accent" href={sectionPath(lang, link.id)}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={T.footer.site}>
        <h2 class="font-mono text-xs font-semibold text-ink">{T.footer.site}</h2>
        <ul class="mt-3 space-y-2 font-mono text-xs text-ink-2">
          {
            projects.map((project) => (
              <li>
                <a
                  class="hover:text-accent"
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {project.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-mono text-xs font-semibold text-ink">{T.footer.language}</h2>
        <div class="mt-3">
          <LanguageSwitcher lang={lang} path={Astro.url.pathname} />
        </div>
      </div>
    </div>

    <div
      class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-5 font-mono text-[11px] text-ink-3"
    >
      <p>{T.footer.rights.replace('2026', String(year))}</p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>build: <span class="text-ink-2">{commit}</span></span>
        <span>{buildDate}</span>
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="text-ink-3 transition-colors hover:text-accent"
        >
          <Icon name="github" class="h-4 w-4" />
        </a>
      </p>
    </div>
  </div>
</footer>
