---
import SectionShell from './SectionShell.astro';
import { t, type Lang } from '../i18n/ui';
import { milestones } from '../data/path';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<SectionShell
  id="path"
  number="05"
  label={T.path.label}
  title={T.path.title}
  subtitle={T.path.subtitle}
  lang={lang}
>
  <ol class="grid grid-cols-1 gap-x-10 md:grid-cols-[200px_1fr]">
    {
      milestones.map((milestone, index) => (
        <li
          class="col-span-full grid grid-cols-subgap md:col-span-2 md:grid-cols-[200px_1fr] md:gap-x-10"
          data-animate
          data-animate-delay={index * 0.05}
        >
          <div class="flex items-baseline gap-3 border-b border-dashed border-border py-3 font-mono text-xs md:border-b-0 md:border-r md:py-1.5 md:pr-6">
            <span
              class:list={[
                'inline-block h-[13px] w-[13px] shrink-0 rounded-full border-2 bg-surface',
                milestone.tbd ? 'border-warning' : 'border-accent',
              ]}
              aria-hidden="true"
            />
            <span class:list={['font-semibold', milestone.tbd ? 'text-warning' : 'text-accent']}>
              {milestone.version}
            </span>
            <span class="text-text-muted">{milestone.date}</span>
          </div>
          <p
            class:list={[
              't-body pb-6 md:py-1.5',
              milestone.tbd ? 'text-text-muted' : 'text-text-secondary',
            ]}
          >
            {milestone.summary[lang]}
          </p>
        </li>
      ))
    }
  </ol>
</SectionShell>
