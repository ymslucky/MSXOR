---
interface Props {
  label: string;
  title: string;
  subtitle?: string;
  lang: string;
}

const { label, title, subtitle, lang } = Astro.props;
---

<div class="mx-auto max-w-2xl text-center" data-animate>
  <p class="font-mono text-xs text-accent">{label}</p>
  <h2
    class="mt-3 text-2xl font-semibold tracking-tight text-balance text-ink md:text-4xl"
    lang={lang}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-4 text-sm leading-relaxed text-pretty text-ink-2 md:text-base">{subtitle}</p>
    )
  }
</div>
