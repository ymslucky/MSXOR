---
import { t, githubUrl, sectionPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
---

<section data-hero-root class="relative overflow-hidden bg-bg">
  <div class="grid-bg absolute inset-0" aria-hidden="true"></div>

  <div class="content-grid relative">
    <div
      class="section-split grid items-center gap-y-10 pb-[var(--section-space)] pt-[calc(var(--section-space)+var(--header-h))] lg:grid-cols-[7fr_5fr] lg:gap-x-[var(--module-space)]"
    >
      <!-- left: positioning -->
      <div class="min-w-0">
        <p class="hero-fade section-label" style="--d: 0.05s">
          {T.hero.badge}
        </p>

        <h1
          aria-label="MSXOR"
          class="t-hero hero-fade mt-5 font-mono font-bold tracking-tight text-text-primary"
          style="--d: 0.1s"
        >
          {
            ['M', 'S', 'X', 'O', 'R'].map((char, index) => (
              <span class="hero-char-mask" aria-hidden="true">
                <span
                  class:list={['hero-char', char === 'X' && 'text-accent']}
                  style={`--i: ${index}`}
                >
                  {char}
                </span>
              </span>
            ))
          }
        </h1>

        <p class="hero-fade t-body r-65 mt-5 text-pretty text-text-secondary" style="--d: 0.18s">
          {T.hero.positioning}
        </p>

        <div
          class="hero-fade mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono t-small text-text-muted"
          style="--d: 0.24s"
        >
          <span>{T.hero.statusBuilding}</span>
          <span class="text-border-strong select-none">·</span>
          <span>{T.hero.statusLearning}</span>
          <span class="text-border-strong select-none">·</span>
          <span>{T.hero.statusIterating}</span>
        </div>

        <div class="hero-fade mt-8 flex flex-col items-start gap-4" style="--d: 0.3s">
          <button
            id="copy-cmd"
            class="btn btn-accent w-full max-w-[480px] justify-between"
            data-cmd={T.hero.cloneCmd}
            data-magnetic
          >
            <span class="truncate"><span class="c-prompt">$ </span>{T.hero.cloneCmd}</span>
            <span class="kbd" id="copy-state">{T.hero.copyLabel}</span>
          </button>
          <div class="flex flex-wrap items-center gap-3">
            <a href={sectionPath(lang, 'now')} class="btn" data-magnetic>{T.hero.ctaPrimary} →</a>
            <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn" data-magnetic>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.66.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.21.67.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
                ></path>
              </svg>
              {T.hero.ctaSecondary}
            </a>
          </div>
        </div>
      </div>

      <!-- right: terminal anchor -->
      <div class="hero-fade terminal min-w-0 text-left" style="--d: 0.35s">
        <div class="terminal-head">
          <span class="terminal-dot"></span><span class="terminal-dot"></span><span
            class="terminal-dot"></span>
          <span class="terminal-title">{T.hero.terminalTitle}</span>
        </div>
        <div class="terminal-body">
          {
            T.hero.terminalLines.map((line) => (
              <p>
                <span class="t-prompt">$ </span>
                <span class="t-cmd">{line.cmd}</span>
                <br />
                <span class="t-dim">{line.out}</span>
              </p>
            ))
          }
          <p>
            <span class="t-prompt">$ </span><span class="cursor-block" aria-hidden="true"></span>
          </p>
        </div>
        <div
          class="flex flex-wrap items-center gap-x-5 gap-y-1 border-t border-border bg-surface-2 px-4 py-2 font-mono text-[11px] text-text-muted"
        >
          <span
            ><span class="t-prompt">ver </span><span class="text-text-secondary"
              >{T.hero.statusVersion}</span
            ></span
          >
          <span><span class="t-ok">✓</span> {T.hero.statusBuild}</span>
          <span class="flex items-center gap-1.5">
            <span id="gh-stars">★</span>
            <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent"
              >{T.hero.statusStars}</a
            >
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const btn = document.getElementById('copy-cmd');
  const state = document.getElementById('copy-state');
  const copied = state?.dataset.copied ?? 'Copied ✓';
  const idle = state?.textContent ?? 'Copy';

  btn?.addEventListener('click', async () => {
    const cmd = (btn as HTMLElement).dataset.cmd ?? '';
    try {
      await navigator.clipboard.writeText(cmd);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = cmd;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
    if (state) state.textContent = copied;
    gsap.fromTo(btn, { scale: 0.97 }, { scale: 1, duration: 0.15, ease: 'power2.out' });
    setTimeout(() => {
      if (state) state.textContent = idle;
    }, 1600);
  });

  const stars = document.getElementById('gh-stars');
  if (stars) {
    fetch('https://api.github.com/repos/ymslucky/MSXOR')
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (d && typeof d.stargazers_count === 'number')
          stars.textContent = `★ ${d.stargazers_count}`;
      })
      .catch(() => undefined);
  }
</script>
