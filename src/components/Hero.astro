---
import Icon from './Icon.astro';
import { t, pricingPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
const chars = ['M', 'S', 'X', 'O', 'R'];
---

<section
  data-hero-root
  class="relative flex min-h-[100svh] items-center justify-center overflow-hidden pt-24"
>
  <!-- backdrop: grid + floating glow orbs -->
  <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
  <div class="absolute -top-48 left-1/2 -ml-[410px]" aria-hidden="true">
    <div class="h-[560px] w-[820px] rounded-full bg-violet-600/25 blur-[140px] animate-float"></div>
  </div>
  <div class="absolute top-1/3 left-1/2 ml-[80px]" aria-hidden="true">
    <div class="h-[420px] w-[560px] rounded-full bg-cyan-500/18 blur-[130px] animate-float-slow">
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
    <p
      class="hero-fade glass mx-auto inline-flex items-center gap-2.5 rounded-full px-4 py-1.5 text-xs font-medium tracking-wide text-slate-300"
      style="--d: 0.1s"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse-dot"></span>
      {T.hero.badge}
    </p>

    <h1
      aria-label="MSXOR"
      class="mt-8 text-[clamp(4.5rem,17vw,11rem)] leading-none font-bold tracking-[-0.04em] text-white"
      style="text-shadow: 0 0 80px rgb(139 92 246 / 0.35);"
    >
      {
        chars.map((char, index) => (
          <span class="hero-char-mask" aria-hidden="true">
            <span
              class:list={['hero-char', char === 'X' && 'text-gradient']}
              style={`--i: ${index}`}
            >
              {char}
            </span>
          </span>
        ))
      }
    </h1>

    <p
      class="hero-fade mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-balance text-slate-400 md:text-xl"
      style="--d: 0.55s"
    >
      {T.hero.tagline}
    </p>

    <div class="hero-fade mt-10 flex flex-wrap items-center justify-center gap-4" style="--d: 0.7s">
      <a href="#products" class="btn-primary" data-magnetic>
        {T.hero.ctaPrimary}
        <Icon name="arrow" class="h-4 w-4" />
      </a>
      <a href={pricingPath(lang)} class="btn-secondary" data-magnetic>
        {T.hero.ctaSecondary}
      </a>
    </div>
  </div>

  <div
    class="absolute bottom-10 left-1/2 h-10 w-px -translate-x-1/2 bg-gradient-to-b from-transparent via-white/30 to-transparent"
    aria-hidden="true"
  >
  </div>
</section>
