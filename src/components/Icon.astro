---
interface Props {
  name: 'cloud' | 'shield' | 'globe' | 'arrow' | 'check' | 'menu' | 'x' | 'plus' | 'sparkles';
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;

const icons: Record<Props['name'], string> = {
  cloud:
    '<path d="M6.8 19a4.8 4.8 0 1 1 .45-9.57 6.2 6.2 0 0 1 12.05 1.76A3.9 3.9 0 0 1 18.1 19H6.8Z"/>',
  shield: '<path d="M12 3 5 6v5.2c0 4.4 2.95 8.2 7 9.4 4.05-1.2 7-5 7-9.4V6l-7-3Z"/>',
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.9 5.7 3.9 9s-1.4 6.4-3.9 9c-2.5-2.6-3.9-5.7-3.9-9s1.4-6.4 3.9-9Z"/>',
  arrow: '<path d="M5 12h14m-6-6 6 6-6 6"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  x: '<path d="m6 6 12 12M18 6 6 18"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  sparkles:
    '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3Z"/><path d="M19 15.5l.9 2.4 2.4.9-2.4.9-.9 2.4-.9-2.4-2.4-.9 2.4-.9.9-2.4Z"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
