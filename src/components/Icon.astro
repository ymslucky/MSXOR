---
interface Props {
  name:
    | 'drive'
    | 'iam'
    | 'evolution'
    | 'globe'
    | 'arrow'
    | 'check'
    | 'menu'
    | 'x'
    | 'plus'
    | 'sparkles'
    | 'github';
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;

const icons: Record<Props['name'], string> = {
  // Drive = 外接大脑：芯片
  drive:
    '<rect x="7" y="7" width="10" height="10" rx="2"/><path d="M9 3.5V7M15 3.5V7M9 17v3.5M15 17v3.5M3.5 9H7M3.5 15H7M17 9h3.5M17 15h3.5"/><rect x="10.2" y="10.2" width="3.6" height="3.6" rx="1"/>',
  // IAM = 身份门：盾牌 + X
  iam: '<path d="M12 3 5 6v5.2c0 4.4 2.95 8.2 7 9.4 4.05-1.2 7-5 7-9.4V6l-7-3Z"/><path d="m9.6 9.6 4.8 4.8m0-4.8-4.8 4.8"/>',
  // 进化门：X + 四端节点
  evolution:
    '<path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/><circle cx="6.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/><circle cx="6.5" cy="17.5" r="1.5" fill="currentColor" stroke="none"/><circle cx="17.5" cy="17.5" r="1.5" fill="currentColor" stroke="none"/>',
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.9 5.7 3.9 9s-1.4 6.4-3.9 9c-2.5-2.6-3.9-5.7-3.9-9s1.4-6.4 3.9-9Z"/>',
  arrow: '<path d="M5 12h14m-6-6 6 6-6 6"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  x: '<path d="m6 6 12 12M18 6 6 18"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  github:
    '<path fill="currentColor" stroke="none" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.66.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.21.67.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>',
  sparkles:
    '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3Z"/><path d="M19 15.5l.9 2.4 2.4.9-2.4.9-.9 2.4-.9-2.4-2.4-.9 2.4-.9.9-2.4Z"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
