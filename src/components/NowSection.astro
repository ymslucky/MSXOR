---
import SectionShell from './SectionShell.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
const isTbd = (body: string) => body.includes('[TBD]') || body.includes('【待确认】');
const items = [
  { title: T.now.buildingTitle, body: T.now.buildingBody },
  { title: T.now.learningTitle, body: T.now.learningBody },
  { title: T.now.experimentingTitle, body: T.now.experimentingBody },
];
---

<SectionShell
  id="now"
  number="01"
  label={T.now.label}
  title={T.now.title}
  subtitle={T.now.subtitle}
  lang={lang}
>
  <div class="grid-cards">
    {
      items.map((item, index) => (
        <div class="card card-pad" data-animate data-animate-delay={index * 0.06}>
          <div class="flex items-center justify-between gap-3">
            <h3 class="t-h3 font-mono font-semibold text-text-primary">{item.title}</h3>
            {isTbd(item.body) && <span class="badge badge-accent">{T.now.tbd}</span>}
          </div>
          <p
            class:list={[
              't-body mt-3',
              isTbd(item.body) ? 'text-text-muted' : 'text-text-secondary',
            ]}
          >
            {item.body}
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-6 font-mono text-[11px] text-text-muted" data-animate>{T.now.updated}</p>
</SectionShell>
