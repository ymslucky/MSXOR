---
import { type Plan } from '../../data/plans';
import { t, productsPath, type Lang } from '../../i18n/ui';

interface Props {
  plan: Plan;
  lang: Lang;
  mode?: 'preview' | 'full';
  delay?: number;
}

const { plan, lang, mode = 'full', delay = 0 } = Astro.props;
const T = t(lang);
const features = mode === 'preview' ? plan.features[lang].slice(0, 3) : plan.features[lang];
---

<div
  class:list={[
    'glass relative flex flex-col p-8',
    plan.popular && 'border-violet-400/40 shadow-[0_0_60px_-15px_rgb(139_92_246/0.45)]',
  ]}
  data-animate
  data-animate-delay={delay}
  data-animate-pop
>
  {
    plan.popular && (
      <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-violet-500 to-cyan-400 px-3 py-1 text-xs font-semibold whitespace-nowrap text-white">
        {T.plan.popular}
      </span>
    )
  }

  <h3 class="text-sm font-semibold tracking-wide text-slate-300 uppercase">{plan.name}</h3>

  <p class="mt-4 flex items-baseline gap-1">
    <span class="text-5xl font-bold tracking-tight text-white">
      $<span data-counter={plan.price}>{plan.price}</span>
    </span>
    <span class="text-sm text-slate-400">{T.plan.period}</span>
  </p>

  <p class="mt-3 text-sm leading-relaxed text-slate-400">{plan.blurb[lang]}</p>

  <ul class="mt-7 flex-1 space-y-3 text-sm text-slate-300">
    {
      features.map((feature) => (
        <li class="flex items-start gap-2.5">
          <svg
            class="mt-0.5 h-4 w-4 shrink-0 text-cyan-300"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m5 12.5 4.5 4.5L19 7.5" />
          </svg>
          {feature}
        </li>
      ))
    }
  </ul>

  {
    mode === 'full' && (
      <a
        href={productsPath(lang)}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          'mt-8 inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-medium transition-all',
          plan.popular ? 'btn-primary' : 'btn-secondary',
        ]}
        data-magnetic
      >
        {T.plan.getStarted}
      </a>
    )
  }
</div>
