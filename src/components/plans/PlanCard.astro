---
import { type Plan } from '../../data/plans';
import { t, sectionPath, type Lang } from '../../i18n/ui';

interface Props {
  plan: Plan;
  lang: Lang;
  mode?: 'preview' | 'full';
  delay?: number;
}

const { plan, lang, mode = 'full', delay = 0 } = Astro.props;
const T = t(lang);
const features = mode === 'preview' ? plan.features[lang].slice(0, 3) : plan.features[lang];
---

<div
  class:list={['card card-pad relative flex flex-col', plan.popular && 'border-line-strong']}
  data-animate
  data-animate-delay={delay}
>
  {plan.popular && <span class="badge badge-ok absolute -top-2.5 left-4">{T.plan.popular}</span>}

  <h3 class="font-mono text-sm font-semibold text-text-primary">{plan.name}</h3>

  <p class="mt-3 flex items-baseline gap-1.5">
    <span class="font-mono text-4xl font-bold text-text-primary">${plan.price}</span>
    <span class="font-mono text-xs text-text-muted">{T.plan.period}</span>
  </p>

  <p class="mt-2 text-xs leading-relaxed text-text-secondary">{plan.blurb[lang]}</p>

  <ul class="mt-5 flex-1 space-y-2.5 font-mono text-xs text-text-secondary">
    {
      features.map((feature) => (
        <li class="flex items-start gap-2">
          <span style="color: var(--color-ok);">✓</span>
          {feature}
        </li>
      ))
    }
  </ul>

  {
    mode === 'full' && (
      <a
        href={sectionPath(lang, 'projects')}
        class:list={['mt-6 btn', plan.popular ? 'btn-accent' : '']}
        data-magnetic
      >
        {T.plan.getStarted}
      </a>
    )
  }
</div>
