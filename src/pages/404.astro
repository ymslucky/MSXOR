---
import LayoutEn from '../layouts/LayoutEn.astro';
import { t } from '../i18n/ui';

const T = t('en');
---

<LayoutEn
  lang="en"
  path="/404"
  title={T.meta.notFound.title}
  description={T.meta.notFound.description}
>
  <section
    data-bg="#05060a"
    class="relative flex min-h-[100svh] flex-col items-center justify-center overflow-hidden px-6 text-center"
  >
    <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
    <div class="absolute top-1/4 left-1/2 -ml-[300px]" aria-hidden="true">
      <div class="h-[380px] w-[600px] rounded-full bg-violet-600/20 blur-[130px]"></div>
    </div>
    <div class="relative" data-animate data-animate-pop>
      <p class="text-gradient text-[clamp(6rem,22vw,12rem)] leading-none font-bold tracking-tight">
        404
      </p>
      <p class="mt-6 text-lg text-slate-400">{T.notFound.message}</p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="btn-primary">{T.notFound.homeEn}</a>
        <a href="/zh/" class="btn-secondary">{T.notFound.homeZh}</a>
        <a href="/pricing" class="btn-secondary">{T.notFound.pricing}</a>
      </div>
    </div>
  </section>
</LayoutEn>
