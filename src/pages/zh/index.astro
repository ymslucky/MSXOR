---
import LayoutZh from '../../layouts/LayoutZh.astro';
import Hero from '../../components/Hero.astro';
import NowSection from '../../components/NowSection.astro';
import ProjectsSection from '../../components/ProjectsSection.astro';
import ArticlesSection from '../../components/ArticlesSection.astro';
import StackSection from '../../components/StackSection.astro';
import PathSection from '../../components/PathSection.astro';
import AboutSection from '../../components/AboutSection.astro';
import ContactCta from '../../components/ContactCta.astro';
import { t } from '../../i18n/ui';

const T = t('zh');
---

<LayoutZh lang="zh" path="/zh/" title={T.meta.home.title} description={T.meta.home.description}>
  <Hero lang="zh" />
  <NowSection lang="zh" />
  <ProjectsSection lang="zh" />
  <ArticlesSection lang="zh" />
  <StackSection lang="zh" />
  <PathSection lang="zh" />
  <AboutSection lang="zh" />
  <ContactCta lang="zh" />
</LayoutZh>
