---
import LayoutZh from '../../layouts/LayoutZh.astro';
import Hero from '../../components/Hero.astro';
import ProductsSection from '../../components/ProductsSection.astro';
import PricingPreview from '../../components/PricingPreview.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { t } from '../../i18n/ui';

const T = t('zh');
---

<LayoutZh lang="zh" path="/zh/" title={T.meta.home.title} description={T.meta.home.description}>
  <Hero lang="zh" />
  <ProductsSection lang="zh" />
  <PricingPreview lang="zh" />
  <CtaBanner lang="zh" />
</LayoutZh>
